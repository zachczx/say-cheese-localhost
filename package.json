{
  "name": "say-cheese-localhost",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "ci": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "^1.2.133",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.1",
    "daisyui": "5.7.40",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-icons": "^24.0.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0"
  }
}
